# =============================================================================
# Adversary-Playbook Synthesizer – Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in the values for your deployment.
# Only GEMINI_API_KEY is required; everything else has a sensible default.
# .env is git-ignored; NEVER commit your real API keys.
# =============================================================================

# -----------------------------------------------------------------------------
# API Keys (required for AI Assistant; no default)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# File / directory paths
# Default: paths relative to the project root
# -----------------------------------------------------------------------------
# MODEL_PATH=cyber_alert_model.pkl
# DATASET_PATH=cyberfeddefender_dataset.csv
# REPORTS_DIR=reports
# SCENARIOS_FILE=scenarios.json

# -----------------------------------------------------------------------------
# Application branding (shown in page title, sidebar, and reports)
# -----------------------------------------------------------------------------
# APP_NAME=Adversary-Playbook Synthesizer

# -----------------------------------------------------------------------------
# Google Gemini LLM settings
# -----------------------------------------------------------------------------
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_TEMPERATURE_ANALYSIS=0.3
# GEMINI_TEMPERATURE_CHAT=0.5
# GEMINI_MAX_TOKENS_ANALYSIS=1000
# GEMINI_MAX_TOKENS_CHAT=500

# -----------------------------------------------------------------------------
# Incident response contact info (used in generated playbooks)
# -----------------------------------------------------------------------------
# INCIDENT_RESPONSE_EMAIL=security@company.com
# EMERGENCY_HOTLINE=+1-XXX-XXX-XXXX
