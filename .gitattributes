# Enforce LF line endings for all text files to prevent Windows/Unix path confusion
# and mixed-line-ending issues in the repository.
* text=auto eol=lf

# Python source files
*.py text eol=lf

# Data / config files
*.json text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.env text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Binary files — do not modify line endings
*.pkl binary
*.joblib binary
